{
  "name": "divyum-bhumra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@8.10.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "pnpm content:check && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "content:check": "node scripts/check-content.mjs",
    "content:new": "node scripts/new-content.mjs",
    "syndicate": "node scripts/syndicate.mjs",
    "test": "vitest",
    "test:unit": "vitest run --coverage",
    "test:e2e": "playwright test tests/e2e",
    "test:a11y": "playwright test tests/a11y --project=chromium-1440",
    "test:visual": "playwright test tests/visual --project=chromium-375 --project=chromium-768 --project=chromium-1440",
    "test:visual:update": "pnpm test:visual --update-snapshots",
    "test:browser": "playwright test",
    "test:lighthouse": "lhci autorun",
    "links:check": "node scripts/check-links.mjs",
    "bundle:report": "node scripts/check-bundle.mjs",
    "bundle:check": "node scripts/check-bundle.mjs --baseline tests/baselines/bundle.json --max-growth-kb 40",
    "quality": "pnpm lint && pnpm typecheck && pnpm content:check && pnpm test:unit && pnpm build && pnpm bundle:check",
    "prepare": "husky"
  },
  "dependencies": {
    "framer-motion": "13.2.0",
    "gray-matter": "4.0.3",
    "next": "16.3.4",
    "next-mdx-remote": "6.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remark-gfm": "4.0.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "husky": "9.1.7",
    "jsdom": "30.0.1",
    "lint-staged": "17.5.0",
    "prettier": "3.9.6",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "unified": "^11.0.5",
    "vitest": "5.0.0"
  }
}
